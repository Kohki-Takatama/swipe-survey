    if (canonicalConfig(sourceConfig.notebooks) !== canonicalConfig(cfg.notebooks)) {
      throw appError('source_config_changed', 'スプシとGitHubの設問が一致しません。設問の差分と既存IDを確認し、最新の設定を同期してから移行を再実行してください');
    }
