function answerEntries(questions, answers) {
  return questions.map(q => ({
    questionId: questionKey(q), label: q.label, type: q.type,
    ...(q.metric ? { metric: q.metric } : {}),
    value: answers[questionKey(q)] ?? null, memo: answers[memoKey(q)] || ''
