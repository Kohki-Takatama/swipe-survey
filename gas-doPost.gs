    ss.getSheets().forEach(sheet => {
      if (sheet.getType() !== SpreadsheetApp.SheetType.GRID) return;
      if (sheet.getLastRow() < 2 || sheet.getRange(1, 1).getValue() !== 'timestamp') return;
