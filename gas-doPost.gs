function parseWeight(value) {
  if (typeof value === 'string') {
    const s = value.trim();
    if (!/^\d+(?:\.\d+)?\s*(?:kg)?$/i.test(s)) return null;
    value = Number(s.replace(/\s*kg$/i, ''));
  }
